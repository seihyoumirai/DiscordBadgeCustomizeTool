{
  "manifest_version": 3,
  "name": "Discord Profile Customize Tool",
  "version": "1.0.7",
  "author": "SeihyouMirai",
  "description": "Discordのプロフィールをカスタマイズする拡張機能。",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://discord.com/*",
    "https://*.discord.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "logo/logo.png",
    "32": "logo/logo.png",
    "48": "logo/logo.png",
    "128": "logo/logo.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*",
        "https://www.discord.com/*",
        "https://canary.discord.com/*",
        "https://ptb.discord.com/*"
      ],
      "js": ["staff-mode-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://discord.com/*",
        "https://www.discord.com/*",
        "https://canary.discord.com/*",
        "https://ptb.discord.com/*"
      ],
      "js": ["staff-mode.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://discord.com/*",
        "https://www.discord.com/*",
        "https://canary.discord.com/*",
        "https://ptb.discord.com/*"
      ],
      "js": ["server-tag-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://discord.com/*",
        "https://www.discord.com/*",
        "https://canary.discord.com/*",
        "https://ptb.discord.com/*"
      ],
      "js": ["profile-customization.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://discord.com/*",
        "https://www.discord.com/*",
        "https://canary.discord.com/*",
        "https://ptb.discord.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://discord.com/*",
        "https://www.discord.com/*",
        "https://canary.discord.com/*",
        "https://ptb.discord.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ]
}
